rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /catalogo/{catalogId} {
      allow read, write: if true;
    }

    match /folders/{folderId} {
      allow read, write: if true;
    }

    match /items/{itemId} {
      allow read, write: if true;
    }

    match /history/{historyId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
